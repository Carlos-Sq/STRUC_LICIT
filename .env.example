# Copia este archivo como ".env" (sin el .example) y completa tus datos reales.
# NUNCA subas el archivo .env real a internet ni lo compartas.

# --- Telegram ---
# 1. Habla con @BotFather en Telegram, escribe /newbot, sigue los pasos y copia el token.
# 2. Habla con @userinfobot (o similar) para obtener tu chat_id numérico.
TELEGRAM_BOT_TOKEN=8668800527:AAGVS2MIp8xipS7red6GlNJRRA_UMKrcMo0
TELEGRAM_CHAT_ID=8553891600

# --- Correo (Gmail recomendado) ---
# EMAIL_PASSWORD debe ser una "Contraseña de aplicación" de Gmail, no tu contraseña normal.
# Créala en: https://myaccount.google.com/apppasswords (requiere verificación en 2 pasos activada)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
EMAIL_FROM=tucorreo@gmail.com
EMAIL_PASSWORD=
EMAIL_TO=tucorreo@gmail.com

# Cada cuántos minutos revisar en modo --loop
INTERVAL_MINUTES=30
